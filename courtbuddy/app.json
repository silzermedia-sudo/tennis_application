{
  "expo": {
    "name": "CourtBuddy",
    "slug": "courtbuddy",
    "version": "1.0.0",
    "scheme": "courtbuddy",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.courtbuddy.app"
    },
    "android": {
      "package": "com.courtbuddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
